# Clerk (get keys from https://dashboard.clerk.com — never commit real values)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key

# Optional Clerk route URLs (defaults work with /sign-in and /sign-up)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Access control — env only. Never commit real emails.
# ADMIN_EMAIL is always allowed. ALLOWLIST_EMAILS is an optional comma-separated list.
ADMIN_EMAIL=admin@example.com
ALLOWLIST_EMAILS=

# Future feed integrations (stubs ignore these today)
# BUKZ_API_BASE_URL=
# BUKZ_API_KEY=
# FAMPOLL_API_BASE_URL=
# FAMPOLL_API_KEY=
